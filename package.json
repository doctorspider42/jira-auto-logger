{
  "name": "jira-auto-logger",
  "version": "0.2.0",
  "description": "Desktop app that suggests Jira/Tempo worklogs from git commits using an LLM",
  "author": "doctorspider42",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:mock": "cross-env JAL_MOCK=1 tauri dev",
    "screenshots": "node scripts/screenshots.mjs",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vite build",
    "icon": "tauri icon build/icon.svg -o src-tauri/icons",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "date-fns": "^3.6.0",
    "i18next": "^23.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
