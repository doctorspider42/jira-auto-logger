{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jira Auto Logger",
  "version": "../package.json",
  "identifier": "com.doctorspider42.jira-auto-logger",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jira Auto Logger",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 520,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "./macos/dmg-background.tiff",
        "windowSize": { "width": 680, "height": 448 },
        "appPosition": { "x": 180, "y": 214 },
        "applicationFolderPosition": { "x": 500, "y": 214 }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0M0FBNzk3NzBFNUFBQjMKUldTenF1VndsNmM2Sk9MdnBKMG5XdCtOdzlNUGptREg3OXF5Qkx6dGVLTzY2Z2lSOGhiVy9PSG0K",
      "endpoints": [
        "https://github.com/doctorspider42/jira-auto-logger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
